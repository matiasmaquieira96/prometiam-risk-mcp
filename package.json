{
  "name": "prometiam-risk-mcp",
  "version": "0.2.8",
  "mcpName": "io.github.matiasmaquieira96/risk-mcp",
  "description": "Model Context Protocol server for the Prometiam company data API — official registry data for Spain, France, the UK, Ireland, Poland and Norway, plus directors and UK beneficial ownership, corporate events, insolvency notices, VAT (VIES) and LEI (GLEIF) lookup and sanctions screening, as native MCP tools for Claude, Cursor and any MCP-compatible client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "prometiam-risk-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check:parity": "node scripts/check-parity.mjs",
    "build": "npm run check:parity && tsc",
    "prepublishOnly": "npm run check:parity && npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "smoke": "echo '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}' | node dist/index.js",
    "check:surfaces": "node scripts/check-surfaces.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "prometiam",
    "company-registry",
    "kyb",
    "kyc",
    "sanctions",
    "compliance",
    "borme",
    "bodacc",
    "companies-house",
    "brreg",
    "eu",
    "uk",
    "norway",
    "company-data",
    "company-search",
    "registry-api",
    "open-data",
    "aml",
    "due-diligence",
    "counterparty",
    "beneficial-ownership",
    "insolvency",
    "spain",
    "france",
    "ireland",
    "poland"
  ],
  "author": "Prometiam <support@prometiam.com> (https://www.prometiam.com)",
  "license": "MIT",
  "homepage": "https://github.com/matiasmaquieira96/prometiam-risk-mcp#readme",
  "bugs": {
    "url": "https://github.com/matiasmaquieira96/prometiam-risk-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matiasmaquieira96/prometiam-risk-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
