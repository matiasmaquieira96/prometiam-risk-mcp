{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.matiasmaquieira96/risk-mcp",
  "title": "Prometiam Company Data",
  "description": "Company data and KYB API for 29 countries: monitoring, financial statements, insolvency, sanctions",
  "version": "0.4.45",
  "websiteUrl": "https://www.prometiam.com/risk-api",
  "repository": {
    "url": "https://github.com/matiasmaquieira96/prometiam-risk-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "prometiam-risk-mcp",
      "version": "0.4.45",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PROMETIAM_API_KEY",
          "description": "Prometiam API key (rk_live_* or rk_test_*). Optional: without it the server runs on a shared demo key (2,000 calls a day for everyone). Your own key, on a free 14-day trial with 500 credits (a card is required, nothing is charged until the trial ends): https://www.prometiam.com/signup?utm_source=mcp",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "PROMETIAM_BASE_URL",
          "description": "Override the API base URL. Default: https://api.prometiam.com/functions/v1/risk-api",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol/registry": {
      "categories": [
        "finance",
        "business",
        "open-data"
      ]
    },
    "com.prometiam": {
      "tools": [
        "companies_search",
        "company_detail",
        "company_by_identifier",
        "events_search",
        "events_timeline",
        "event_detail",
        "people_search",
        "person_detail",
        "directors_network",
        "sanctions_screen",
        "sanctions_entity",
        "vat_validate",
        "lei_lookup",
        "lei_search",
        "lei_relationships",
        "insolvency_search",
        "insolvency_notices_search",
        "insolvency_record",
        "coverage",
        "account",
        "monitor_list",
        "monitor_get",
        "monitor_subscribe",
        "monitor_stop",
        "companies_lookup",
        "company_financials",
        "insolvency_check",
        "procurement_awards",
        "procurement_buyer",
        "procurement_buyers",
        "procurement_relationship",
        "sanctions_changes",
        "sanctions_screen_batch",
        "sanctions_unwatch",
        "sanctions_watch",
        "sanctions_watchlist"
      ],
      "countries": [
        "ES",
        "FR",
        "GB",
        "IE",
        "PL",
        "NO",
        "FI",
        "SE",
        "HR",
        "BE",
        "DK",
        "EE",
        "SK",
        "CH",
        "LV",
        "CY",
        "RO",
        "US",
        "LT",
        "CA",
        "AU",
        "JP",
        "IL",
        "BR",
        "CO",
        "SG",
        "TW",
        "CZ",
        "DE"
      ],
      "data_residency": "EU (Frankfurt)",
      "license": "MIT"
    }
  }
}
